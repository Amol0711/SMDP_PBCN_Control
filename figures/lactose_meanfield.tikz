\providecommand{\FigureDataDir}{../data}
\begin{tikzpicture}
\begin{groupplot}[
 group style={group size=2 by 3,horizontal sep=1.4cm,vertical sep=1.1cm},
 width=0.45\textwidth,height=0.205\textheight,
 xmin=0,xmax=620,xtick={0,200,400,600},grid=major,
 tick label style={font=\small},label style={font=\small},
 title style={font=\normalsize},scaled y ticks=false,
]
\nextgroupplot[title={(a) Task-reward rate},ylabel={$\eta$},ymin=-0.02,ymax=1.05,ytick={0,0.5,1},xticklabels={,,}]
\addplot[line width=1.05pt,blue!70!black] table[col sep=comma,x=iteration,y=eta] {\FigureDataDir/lactose_meanfield_trace.csv};
\nextgroupplot[title={(b) Update rate},ylabel={$\kappa$},ymin=0.19,ymax=0.34,ytick={0.20,0.25,0.30},xticklabels={,,}]
\addplot[line width=1.05pt,blue!70!black] table[col sep=comma,x=iteration,y=update_rate] {\FigureDataDir/lactose_meanfield_trace.csv};
\addplot[black!65,dashed] coordinates {(0,0.25)(620,0.25)} node[pos=0.98,anchor=south east,font=\small,fill=white,inner sep=1pt] {$\Gamma=0.25$};
\nextgroupplot[title={(c) Dual multiplier},ylabel={$\lambda$},ymin=-0.03,ymax=1.02,ytick={0,0.5,1},xticklabels={,,}]
\addplot[line width=1.05pt,blue!70!black] table[col sep=comma,x=iteration,y=lambda] {\FigureDataDir/lactose_meanfield_trace.csv};
\nextgroupplot[title={(d) Projected actor residual},ylabel={$R_{\rm act}$},ymode=log,ymin=0.000005,ymax=0.5,ytick={0.00001,0.001,0.1},xticklabels={,,}]
\addplot[line width=1.05pt,blue!70!black] table[col sep=comma,x=iteration,y=actor_stationarity_rate] {\FigureDataDir/lactose_meanfield_trace.csv};
\addplot[black!65,dashed] coordinates {(0,0.00001)(620,0.00001)} node[pos=0.98,anchor=south east,font=\small,fill=white,inner sep=1pt] {$10^{-5}$};
\nextgroupplot[title={(e) Primal violation},xlabel={Mean-field iteration},ylabel={$R_{\rm pri}$},ymin=-0.003,ymax=0.09,ytick={0,0.04,0.08}]
\addplot[line width=1.05pt,blue!70!black] table[col sep=comma,x=iteration,y=primal_feasibility_rate] {\FigureDataDir/lactose_meanfield_trace.csv};
\nextgroupplot[title={(f) Complementarity},xlabel={Mean-field iteration},ylabel={$R_{\rm comp}$},ymin=-0.002,ymax=0.05,ytick={0,0.02,0.04}]
\addplot[line width=1.05pt,blue!70!black] table[col sep=comma,x=iteration,y=complementarity_rate] {\FigureDataDir/lactose_meanfield_trace.csv};
\end{groupplot}
\end{tikzpicture}
