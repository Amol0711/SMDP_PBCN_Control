\addplot[black!65,dashed] coordinates {(0,0.3)(1,0.3)} node[pos=0.98,anchor=south east,font=\small,fill=white,inner sep=1pt] {$\Gamma=0.30$};
\nextgroupplot[title={(c) Owned multiplier},ylabel={$\lambda$},ymin=0.05,ymax=0.38,ytick={0.1,0.2,0.3},xticklabels={,,}]
