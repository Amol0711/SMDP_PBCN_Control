\providecommand{\FigureDataDir}{../data}
\begin{tikzpicture}
\begin{groupplot}[group style={group size=2 by 3,horizontal sep=1.35cm,vertical sep=1.05cm},width=7.15cm,height=4.05cm,xmin=0,xmax=1,xtick={0,0.5,1},grid=major,scaled y ticks=false,tick label style={font=\small},label style={font=\small},title style={font=\small},unbounded coords=jump]
