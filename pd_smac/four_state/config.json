    "fixed_duration_state_input",
    "deterministic_state_action",
    "randomized_occupation_LP"
  ],
  "algorithms": {
    "actor": {
      "type": "state-tabular softmax(W[state]/temperature)",
      "temperature": "max(0.15,1-0.85*episode/1200)",
      "domain": "each logit row sums to zero and lies in [-12,12]",
      "projection": "true Euclidean zero-sum-box projection after actor step",
      "score": "(onehot-p)/temperature; deliberate correction to inherited update",
      "gain": "0.12/(1+episode/1000)^0.6"
    },
    "critic": {
      "gain": "0.16/(1+episode/1000)^0.6",
      "eta_gain": "0.05/(1+episode/1000)^0.6",
      "td": "R-lambda-eta*tau+h(next)-h(state)",
      "normalization": "subtract h(S) after each update"
    },
    "dual": {
      "gain": "0.08/(1+episode/1000)^0.6",
      "bounds": [
        0.0,
        50.0
      ],
      "residual": "1-0.30*tau, duration-scaled numerator per decision"
    },
    "policy_saving": [
      "W",
      "h",
      "eta",
      "lambda",
      "temperature",
      "action_order",
      "projection_contract_id",
      "rng_state",
      "full stochastic action probabilities",
      "greedy action map"
    ],
    "exact_reference": {
      "deterministic_maps": 10000,
      "fixed_duration_input_maps_per_duration": 16,
      "occupation_LP": "max sum_y y*g subject flow, sum_y y*tau=1, sum_y y<=0.30, y>=0",
      "policy_recovery": "pi(a|s)=y(s,a)/sum_b y(s,b) for positive mass rows; zero-mass rows use fixed action (u=0,tau=5), verify recovered-chain feasibility and initial-class effect",
      "tie_break": "primary objective within1e-10; then minimum update rate within1e-10; then lexicographically smallest canonical action-index tuple",
      "checks": "flow, time normalization, expenditure, dual feasibility/gap, recovered policy and independent deterministic Bellman/dual checks; do not require historic audit values as acceptance thresholds"
    }
  }
}
